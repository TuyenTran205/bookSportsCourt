    "db:migrate": "node --loader ts-node/esm --no-warnings scripts/migrate.ts",
    "db:seed": "node --loader ts-node/esm --no-warnings scripts/seed.ts",
    "db:studio": "drizzle-kit studio --config ../../drizzle.config.ts",
    "test:group1": "node --loader ts-node/esm --no-warnings --test scripts/group1-api.test.ts",
    "test:payment-review": "node --loader ts-node/esm --no-warnings --test scripts/payment-review-api.test.ts scripts/payment-review-rules.test.ts",
    "test:owner-applications": "node --loader ts-node/esm --no-warnings --test scripts/owner-applications-api.test.ts",
    "test:users": "node --loader ts-node/esm --no-warnings --test scripts/user-management-api.test.ts",
    "test:admin-reporting": "node --loader ts-node/esm --no-warnings --test scripts/admin-reporting-api.test.ts scripts/admin-reporting-rules.test.ts scripts/admin-reporting-migration.test.ts",
    "test:business-mail": "node --loader ts-node/esm --no-warnings --test scripts/business-mail.test.ts",
    "mail:retry": "node --loader ts-node/esm --no-warnings scripts/retry-business-mail.ts",
    "test:reviews": "node --loader ts-node/esm --no-warnings --test scripts/reviews-api.test.ts scripts/review-rules.test.ts",
    "test:google-oauth": "node --loader ts-node/esm --no-warnings --test scripts/google-oauth-api.test.ts scripts/google-provider.test.ts",
    "test:password-recovery": "node --loader ts-node/esm --no-warnings --test scripts/password-recovery-api.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "contract:check": "node --loader ts-node/esm --no-warnings scripts/phase4-contract.ts",
    "contract:export": "node --loader ts-node/esm --no-warnings scripts/phase4-contract.ts --write",
    "test:contract": "node --loader ts-node/esm --no-warnings --test scripts/phase4-contract.test.ts",
    "contract:final": "node --loader ts-node/esm --no-warnings scripts/phase4-contract.ts --require-final",
    "postman:export": "node scripts/export-phase4-postman.mjs"
