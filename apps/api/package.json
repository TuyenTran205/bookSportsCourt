    "test:venue-fixtures": "node --loader ts-node/esm --no-warnings --test scripts/venue-fixtures.test.ts",
    "test:venues": "node --loader ts-node/esm --no-warnings --test --test-concurrency=1 scripts/venue-create.test.ts scripts/venue-contract.test.ts scripts/venue-moderation.test.ts scripts/venue-fixtures.test.ts scripts/jwt-auth-guard.test.ts scripts/roles-guard.test.ts scripts/permissions-decorators.test.ts",
    "test:venue-create": "node --loader ts-node/esm --no-warnings --test scripts/venue-create.test.ts",
    "test:venue-contract": "node --loader ts-node/esm --no-warnings --test scripts/venue-contract.test.ts",
    "test:venue-moderation": "node --loader ts-node/esm --no-warnings --test scripts/venue-moderation.test.ts",
    "test:jwt-auth-guard": "node --loader ts-node/esm --no-warnings --test scripts/jwt-auth-guard.test.ts",
    "test:permissions-decorators": "node --loader ts-node/esm --no-warnings --test scripts/permissions-decorators.test.ts",
    "test:http-security": "node --loader ts-node/esm --no-warnings --test scripts/http-security.test.ts",
