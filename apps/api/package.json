    "test:bookings": "node --loader ts-node/esm --no-warnings --test scripts/booking-rules.test.ts scripts/booking-api.test.ts",
    "test:payments": "node --loader ts-node/esm --no-warnings --test scripts/payment-api.test.ts scripts/proof-storage.test.ts",
