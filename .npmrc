# pnpm – cấu hình dùng chung cho monorepo BookSportsCourt

# Bắt buộc: các package con khai báo dependency tường minh.
# Tránh việc apps/web vô tình import được thư viện mà nó không khai báo.
hoist-pattern[]=*eslint*
hoist-pattern[]=*prettier*

# Next.js và sharp cần build script – pnpm 9 chặn mặc định.
onlyBuiltDependencies[]=sharp
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=@tailwindcss/oxide
onlyBuiltDependencies[]=unrs-resolver
