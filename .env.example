# BookSportsCourt – mẫu biến môi trường
#
# Cách dùng:
#   cp .env.example .env.local      # rồi điền giá trị thật
#
# File này CHỈ chứa tên biến và giá trị mẫu, KHÔNG chứa bí mật thật.
# Không commit .env.local / .env.production (đã có trong .gitignore).
# Danh sách bắt buộc và checklist deploy: docs/06-security-and-permissions.md
# Schema validate ở startup: docs/10-backend-conventions.md

# ── Database ──────────────────────────────────────────────────────────────
# Neon (production) hoặc PostgreSQL local khi phát triển.
# Local: postgresql://postgres:postgres@localhost:5432/booksportscourt
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booksportscourt

# ── Backend ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Bí mật JWT – BẮT BUỘC tối thiểu 32 ký tự. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Dùng giá trị KHÁC NHAU cho access và refresh.
JWT_ACCESS_SECRET=doi_thanh_chuoi_ngau_nhien_toi_thieu_32_ky_tu
JWT_REFRESH_SECRET=doi_thanh_chuoi_ngau_nhien_khac_toi_thieu_32_ky_tu

# Thời hạn token
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Google OAuth ──────────────────────────────────────────────────────────
# Lấy ở Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI: http://localhost:3001/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
AUTH_FRONTEND_URL=http://localhost:3000
# Separate 32-byte AES key as 64 hex characters; never reuse JWT secrets.
OAUTH_STATE_ENCRYPTION_KEY=

# ── Cloudflare R2 (lưu ảnh venue + ảnh xác nhận chuyển khoản) ─────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=booksportscourt
R2_PROOF_BUCKET=
# URL công khai của bucket (hoặc custom domain)
R2_PUBLIC_URL=https://<r2-public-domain>

# ── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=
BUSINESS_MAIL_ENABLED=false
MAIL_FROM="BookSportsCourt <no-reply@<mail-domain>>"

# ── CORS ──────────────────────────────────────────────────────────────────
# Nhiều origin thì ngăn cách bằng dấu phẩy.
# Production chỉ được liệt kê domain thật, KHÔNG dùng *.
ALLOWED_ORIGINS=http://localhost:3000

# ── Nghiệp vụ booking (xem docs/05-booking-and-realtime.md) ───────────────
# Thời gian giữ chỗ (phút)
HOLD_TTL_MINUTES=10
# Số hold tối đa một khách được giữ cùng lúc (mã lỗi HOLD_LIMIT_EXCEEDED)
HOLD_LIMIT=3
# Số lần tối đa một khách được giữ RỒI THẢ cùng một court trong 1 giờ
# (cửa sổ trượt 60 phút, mã lỗi HOLD_RATE_LIMITED — xem docs/06-security-and-permissions.md)
HOLD_RATE_LIMIT_PER_HOUR=5
# Hạn chủ sân duyệt thanh toán (giờ) trước khi cron tự huỷ
OWNER_REVIEW_TIMEOUT_HOURS=2
# Khoảng đệm trước khi cron chuyển confirmed → completed (phút)
AUTOCOMPLETE_GRACE_MINUTES=30

# ── Observability ─────────────────────────────────────────────────────────
# Để trống cũng được ở môi trường dev.
SENTRY_DSN=

# ── Frontend (apps/web) ───────────────────────────────────────────────────
# NEXT_PUBLIC_* được inline vào bundle lúc build → không đặt bí mật ở đây.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Bật MSW để dựng giao diện bằng dữ liệu giả khi backend chưa có.
# `enabled` = chặn request và trả fixture; `disabled` = gọi backend thật.
# Đặt trong .env.local khi phát triển UI; production luôn để `disabled`.
NEXT_PUBLIC_API_MOCKING=disabled

# Bản đồ Việt Nam PMTiles tự host trên Cloudflare R2 (ADR-031 - MapLibre GL JS)
# Khuyên dùng Custom Domain R2 (ví dụ https://map.booksportscourt.id.vn/map/vietnam.pmtiles)
# để đi qua Cloudflare Edge CDN tại Việt Nam; để trống sẽ dùng nguồn Esri / OSM miễn phí.
NEXT_PUBLIC_VIETNAM_PMTILES_URL=
# Tuỳ chọn URL font glyphs (.pbf) hỗ trợ tiếng Việt cho MapLibre GL
# Mặc định sử dụng CDN Protomaps basemaps-assets nếu để trống (hoặc dùng R2: https://<r2-domain>/map/fonts/{fontstack}/{range}.pbf)
NEXT_PUBLIC_MAP_GLYPHS_URL=
